# Copy to .env and fill in. Never commit or share .env. Keep a copy somewhere safe: you need the same values to upgrade.

# Which release is installed (install.sh and upgrade.sh set this for you) and where its images come from.
FMS_VERSION=
FMS_REGISTRY=ghcr.io/mirffan215

# The one organisation this installation serves. Choose a GUID once (for example `uuidgen`) and never change it. A license can be bound to it.
FMS_TENANT_ID=
FMS_TENANT_NAME=Default

# The address people open in their browser (your load balancer's https address).
FMS_PUBLIC_URL=https://fms.example.com
FMS_HTTP_PORT=8080

# Sign-in: your OpenID Connect provider. The client is a public client (PKCE) registered for this site.
FMS_AUTH_NAME=corp
FMS_AUTH_AUTHORITY=https://login.example.com
FMS_AUTH_AUDIENCE=api://fms
FMS_AUTH_CLIENT_ID=
FMS_AUTH_SCOPE=openid profile email
# Tighten the web content-security policy to your provider's origin, e.g. https://login.example.com
FMS_CSP_CONNECT_SRC=https:
# <provider name>:<the administrator's user id (sub) at the provider>
FMS_INITIAL_ADMIN=

# Database. With the bundled SQL Server (profile bundled-sql) set the SA password. With your own SQL Server set the two connection strings
# (an owner login for upgrades, and the application's own login) and leave MSSQL_SA_PASSWORD empty.
MSSQL_SA_PASSWORD=
FMS_APP_LOGIN_PASSWORD=
FMS_MIGRATOR_CONNECTION=
FMS_APP_CONNECTION=

# Email notifications (optional). Provider None keeps them off; in-app notices always work.
FMS_EMAIL_PROVIDER=None
FMS_EMAIL_HOST=
FMS_EMAIL_PORT=587
FMS_EMAIL_USER=
FMS_EMAIL_PASSWORD=
FMS_EMAIL_FROM=
