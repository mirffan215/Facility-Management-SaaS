# Copy to .env and set real values. Never commit .env.
MSSQL_SA_PASSWORD=
FMS_APP_LOGIN_PASSWORD=
FMS_TENANT_ID=00000000-0000-0000-0000-000000000000
FMS_TENANT_NAME=Default
# Provider name from Authentication__Providers__N__Name and the user's subject ("sub") claim, e.g. corp:1234-abcd
FMS_INITIAL_ADMIN=
# Email notifications (optional). Provider None keeps them off; in-app notices always work. For Smtp set host, user, password and sender.
FMS_EMAIL_PROVIDER=None
FMS_EMAIL_HOST=
FMS_EMAIL_PORT=587
FMS_EMAIL_USER=
FMS_EMAIL_PASSWORD=
FMS_EMAIL_FROM=
