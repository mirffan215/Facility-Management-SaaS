# Served by the web container. The browser talks to ONE origin: static files from here, /api/ proxied to the API (so no CORS needed).
# Variables (see docker-compose.onprem.yml): API_UPSTREAM, CSP_CONNECT_SRC.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 30m;     # a little above the API's 25 MB file limit; the API enforces the real limit
  server_tokens off;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "no-referrer" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  # Scripts and styles only from this origin. connect-src also lists where the identity provider's token endpoint lives.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_request_buffering off;
    proxy_hide_header X-Content-Type-Options;   # the server-level header already sets it; avoid a duplicate
  }

  location /health/ {
    proxy_pass ${API_UPSTREAM};
  }

  # NOTE: nginx drops every inherited add_header as soon as a location declares its own. The security headers above therefore live at
  # server level only, and the locations below set caching with `expires` (which does not interfere).

  # Hashed build files never change: cache them for a year. (Built into /static/, not /assets/, because /assets/... is a page of the app.)
  location /static/ {
    expires 1y;
    try_files $uri =404;
  }

  # Single-page app: any other path is a client-side route; the HTML must always be revalidated so a new release is picked up.
  location / {
    expires -1;
    try_files $uri /index.html;
  }
}
